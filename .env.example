# Secret de signature des sessions Payload.
# En générer un avec :  node -e "console.log(crypto.randomUUID())"
PAYLOAD_SECRET=

# Neon Postgres. Prendre la chaîne du pooler (hôte en `-pooler`, port 5432),
# pas la connexion directe qui n'est joignable qu'en IPv6.
DATABASE_URL=

# UploadThing : jeton de l'application, onglet "API Keys" du dashboard.
UPLOADTHING_TOKEN=
