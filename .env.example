# Secret de signature des sessions Payload.
# En générer un avec :  node -e "console.log(crypto.randomUUID())"
PAYLOAD_SECRET=

# Neon Postgres. Prendre la chaîne du pooler (hôte en `-pooler`, port 5432),
# pas la connexion directe qui n'est joignable qu'en IPv6.
DATABASE_URL=

# UploadThing : jeton de l'application, onglet "API Keys" du dashboard.
UPLOADTHING_TOKEN=

# Resend : envoi du formulaire de contact.
RESEND_API_KEY=
# Boîte qui reçoit les messages. Tant qu'aucun domaine n'est vérifié chez
# Resend, ce doit être l'adresse d'inscription du compte.
CONTACT_TO_EMAIL=
# Expéditeur, une fois un domaine vérifié. Sinon onboarding@resend.dev.
# CONTACT_FROM_EMAIL="BAPZ Studio <contact@exemple.fr>"

# Adresse publique du site, sans barre oblique finale (URL canoniques, sitemap,
# cartes de partage). Vide en local.
NEXT_PUBLIC_SITE_URL=
